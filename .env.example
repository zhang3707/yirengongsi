# ---- Environment ----
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=*

# ---- Data infrastructure ----
# 留空 = 开发环境自动使用本地 SQLite（data/ai_company.db）
# 生产/容器请显式设置，例如：
# DATABASE_URL=postgresql+psycopg2://ai_company:ai_company@localhost:5432/ai_company
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
TEMPORAL_HOST=localhost:7233
STORAGE_PATH=./data/storage
LOG_DIR=./logs

# ---- Model provider ----
MODEL_PROVIDER=mock
MODEL_NAME=mock-reasoner
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=120

# ---- EcomAutopilot (browser-service) ----
ECOM_AUTOPILOT_BASE_URL=http://127.0.0.1:8787
ECOM_AUTOPILOT_TOKEN=dev-token
ECOM_AUTOPILOT_TIMEOUT_SECONDS=180

# ---- Auth（默认关闭，给公网部署时开启）----
API_AUTH_TOKEN=
API_AUTH_ENABLED=false

# ---- Pilot runtime ----
WORKSPACE_NAME=default
MAX_WORKFLOW_RETRIES=2
AUTO_CREATE_TABLES=true
SEED_DEMO_DATA=true
